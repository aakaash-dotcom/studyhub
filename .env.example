# ─── Centum Studio — environment ────────────────────────────────────────────
# Copy to .env and fill in. Dev defaults work out of the box (no keys needed).

# --- Database ---------------------------------------------------------------
# dev  : leave empty -> embedded Postgres (PGlite) at .data/pglite (zero setup)
# prod : set a Postgres URL, e.g. postgres://centum:secret@db:5432/centum
DATABASE_URL=

# --- Security ---------------------------------------------------------------
# 32-byte hex key used to encrypt platform tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Public base URL of this app (OAuth redirects, WhatsApp approval links).
APP_URL=http://localhost:3000

# --- First admin user (created by `npm run db:seed`) ------------------------
# The studio has NO login page (single operator). These two just name the
# owner on the audit trail; there is no password to set.
ADMIN_EMAIL=ravi@centum.local
ADMIN_PASSWORD=centum-admin
ADMIN_NAME=Ravi

# --- Meta / Instagram (PLAN.md §2.2) ---------------------------------------
# Leave in Development Mode; add each page as an Instagram Tester. No App Review.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# --- Google / YouTube (PLAN.md §2.3) ---------------------------------------
# Uploads stay PRIVATE until the YouTube API compliance audit passes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (public media host — Meta/YouTube fetch from here) -------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=centum-media
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=

# --- Google Drive (content drops) ------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=

# --- WhatsApp CRM (notifications only; never in the publishing path) -------
WHATSAPP_CRM_BASE_URL=
WHATSAPP_CRM_API_KEY=
WHATSAPP_CRM_AUTH_HEADER=Authorization
WHATSAPP_CRM_SEND_PATH=/messages
WHATSAPP_CRM_APPROVER_NUMBER=

# --- Providers --------------------------------------------------------------
# mock = safe fake publisher for development; live = real platform APIs
PROVIDER_MODE=mock
LOG_LEVEL=info
