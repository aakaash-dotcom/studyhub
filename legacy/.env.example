# Google Apps Script URL (get this after deploying Apps Script)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional: Base path for subpath deployment (e.g., /library/)
# Leave empty or remove for root deployment
VITE_BASE_PATH=

# Optional: Supabase credentials (for future OTP integration)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
