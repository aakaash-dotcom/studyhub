{
  "name": "centum-studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @centum/studio",
    "build": "npm run build -w @centum/studio",
    "start": "npm run start -w @centum/studio",
    "typecheck": "tsc -p apps/studio/tsconfig.json --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/core/src/db/migrate-cli.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "db:reset": "rm -rf .data && npm run db:migrate && npm run db:seed",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run test",
    "session:dev": "node --env-file-if-exists=.env --import tsx scripts/dev-session.ts",
    "demo:data": "node --env-file-if-exists=.env --import tsx scripts/demo-data.ts",
    "smoke:login": "node --env-file-if-exists=.env --import tsx scripts/smoke-login.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@centum/core": "*",
    "@centum/providers": "*",
    "@centum/media": "*",
    "@centum/notify": "*"
  }
}
